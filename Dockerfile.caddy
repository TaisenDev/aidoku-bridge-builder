FROM caddy:2-alpine

# Caddy needs CAP_NET_BIND_SERVICE to listen on 80/443. Store that one
# capability on the binary, then run as an unprivileged UID in Compose.
USER root
RUN apk add --no-cache libcap-utils \
  && setcap cap_net_bind_service=+ep /usr/bin/caddy \
  && getcap /usr/bin/caddy | grep -q 'cap_net_bind_service=ep' \
  && apk del libcap-utils
USER 1001:1001
